# 复制为 .env.test，首次启动前设置至少 8 个字符的独立密码。
# 后续启动不会用此值覆盖 admin 已保存的密码。
TEST_ADMIN_PASSWORD=
TEST_PORT=8001
TEST_HOST=127.0.0.1

# 默认从正式 runtime 复制到临时目录，进程退出后自动清理。
# 仅在需要连接真实邮箱或 Codex 接口时显式开启；默认保持纯本地模拟。
# TEST_EXTERNAL_WATCHERS=1

# Gmail 测试回调：在 Google 客户端中登记同一地址。
TEST_GMAIL_OAUTH_REDIRECT_BASE=http://localhost:8001
TEST_APP_BASE_URL=http://localhost:8001

# Outlook 测试配置（使用 Outlook 时填写，并登记测试回调）。
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# OUTLOOK_TENANT=common
# OUTLOOK_OAUTH_REDIRECT_URI=http://localhost:8001/api/admin/outlook/auth/callback
